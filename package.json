{
  "name": "doseguard-ai",
  "version": "1.0.0",
  "private": true,
  "description": "DoseGuard AI — Serverless Medication Safety & Caregiver Escalation Platform",
  "workspaces": [
    "backend",
    "frontend",
    "infrastructure"
  ],
  "scripts": {
    "build": "npm run build --workspace=backend && npm run build --workspace=infrastructure && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:infra": "npm run build --workspace=infrastructure",
    "test": "vitest run",
    "test:watch": "vitest",
    "synth": "npm run synth --workspace=infrastructure",
    "deploy": "npm run deploy --workspace=infrastructure"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}

